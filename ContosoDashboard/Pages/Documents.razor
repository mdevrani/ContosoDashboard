@page "/documents"
@using ContosoDashboard.Models
@using ContosoDashboard.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject IProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>Documents</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0">Upload document</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="uploadModel" OnValidSubmit="HandleUploadAsync">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">File</label>
                            <InputFile OnChange="HandleFileSelected" class="form-control" />
                            @if (!string.IsNullOrWhiteSpace(selectedFileName))
                            {
                                <small class="text-muted">Selected: @selectedFileName</small>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <InputText @bind-Value="uploadModel.Title" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="uploadModel.Description" class="form-control" rows="3" />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Category</label>
                                    <InputSelect @bind-Value="uploadModel.Category" class="form-select">
                                        @foreach (var category in documentCategories)
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Project</label>
                                    <InputSelect @bind-Value="selectedProjectId" class="form-select">
                                        <option value="">Personal</option>
                                        @foreach (var project in projects)
                                        {
                                            <option value="@project.ProjectId">@project.Name</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tags</label>
                            <InputText @bind-Value="uploadModel.Tags" class="form-control" placeholder="e.g. design, planning" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(statusMessage))
                        {
                            <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
                        }

                        <button type="submit" class="btn btn-primary" disabled="@(isUploading || selectedFile == null)">
                            @(isUploading ? "Uploading..." : "Upload")
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">My Documents</h5>
                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" placeholder="Search" @bind="searchText" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshDocuments">Refresh</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (documents == null)
                    {
                        <p><em>Loading...</em></p>
                    }
                    else if (!documents.Any())
                    {
                        <p class="text-muted">No documents uploaded yet.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Category</th>
                                        <th>Project</th>
                                        <th>Size</th>
                                        <th>Uploaded</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var document in documents)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@document.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(document.Description))
                                                {
                                                    <br />
                                                    <small class="text-muted">@document.Description</small>
                                                }
                                            </td>
                                            <td>@document.Category</td>
                                            <td>@(document.Project?.Name ?? "Personal")</td>
                                            <td>@FormatBytes(document.FileSize)</td>
                                            <td>@document.UploadedAt.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const int MaxFileSizeBytes = 25 * 1024 * 1024;
    private readonly string[] documentCategories = { "Project Documents", "Team Resources", "Personal Files", "Reports", "Presentations", "Other" };

    private DocumentUploadRequest uploadModel = new();
    private List<Project> projects = new();
    private List<Document> documents = new();
    private IBrowserFile? selectedFile;
    private string? selectedProjectId;
    private string selectedFileName = string.Empty;
    private string searchText = string.Empty;
    private bool isUploading;
    private bool isError;
    private string? statusMessage;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var userId))
        {
            currentUserId = userId;
        }

        projects = await ProjectService.GetUserProjectsAsync(currentUserId);
        await RefreshDocuments();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
        uploadModel.FileName = e.File.Name;
        uploadModel.ContentType = e.File.ContentType;
        statusMessage = null;
    }

    private async Task HandleUploadAsync()
    {
        if (selectedFile == null)
        {
            statusMessage = "Please select a file first.";
            isError = true;
            return;
        }

        if (selectedFile.Size > MaxFileSizeBytes)
        {
            statusMessage = "File exceeds the 25 MB limit.";
            isError = true;
            return;
        }

        var extension = Path.GetExtension(selectedFile.Name).ToLowerInvariant();
        var allowedExtensions = new[] { ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".jpg", ".jpeg", ".png" };
        if (!allowedExtensions.Contains(extension))
        {
            statusMessage = "Unsupported file type. Please choose a PDF, Office document, text file, or image.";
            isError = true;
            return;
        }

        isUploading = true;
        statusMessage = null;
        try
        {
            var request = new DocumentUploadRequest
            {
                Title = uploadModel.Title,
                Description = uploadModel.Description,
                Category = uploadModel.Category,
                ProjectId = string.IsNullOrWhiteSpace(selectedProjectId) ? null : int.Parse(selectedProjectId),
                Tags = uploadModel.Tags,
                FileName = selectedFile.Name,
                ContentType = selectedFile.ContentType,
                FileStream = selectedFile.OpenReadStream(MaxFileSizeBytes)
            };

            await DocumentService.UploadDocumentAsync(request, currentUserId);
            selectedFile = null;
            selectedFileName = string.Empty;
            uploadModel = new DocumentUploadRequest();
            statusMessage = "Document uploaded successfully.";
            isError = false;
            await RefreshDocuments();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task RefreshDocuments()
    {
        documents = await DocumentService.GetUserDocumentsAsync(currentUserId, string.IsNullOrWhiteSpace(searchText) ? null : searchText);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
